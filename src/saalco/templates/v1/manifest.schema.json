{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saal.local/schemas/evidence-manifest-v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "saal_rules_version",
    "saalco_version",
    "target_commit",
    "run_id",
    "executed_at",
    "environment",
    "lockfile",
    "gates",
    "tests",
    "coverage",
    "artifacts",
    "overall"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "saal_rules_version": { "type": "string" },
    "saalco_version": { "type": "string" },
    "target_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}(-[0-9]+)?$" },
    "executed_at": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["os", "python", "arch"],
      "properties": {
        "os": { "type": "string" },
        "python": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "lockfile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "started_at",
          "ended_at",
          "exit_code",
          "result",
          "tool_version"
        ],
        "properties": {
          "name": { "type": "string" },
          "command": { "type": "string" },
          "started_at": { "type": ["string", "null"] },
          "ended_at": { "type": ["string", "null"] },
          "exit_code": { "type": ["integer", "null"] },
          "result": { "enum": ["PASS", "FAIL", "NOT_CONFIGURED", "ERROR"] },
          "tool_version": { "type": ["string", "null"] }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeid", "category", "marker", "referenced_id", "spec", "result"],
        "properties": {
          "nodeid": { "type": "string" },
          "category": { "type": "string" },
          "marker": { "enum": ["verifies", "impl_aware"] },
          "referenced_id": { "type": ["string", "null"] },
          "spec": { "type": ["string", "null"] },
          "result": { "enum": ["PASS", "FAIL", "NOT_EVALUATED"] }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["total", "diff", "diff_base_commit", "status", "json_path"],
      "properties": {
        "total": { "type": ["number", "null"] },
        "diff": { "type": ["number", "null"] },
        "diff_base_commit": { "type": ["string", "null"] },
        "status": { "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
        "json_path": { "type": ["string", "null"] }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "retention_location"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "retention_location": { "type": "string" }
        }
      }
    },
    "overall": { "enum": ["PASS", "FAIL"] }
  }
}
